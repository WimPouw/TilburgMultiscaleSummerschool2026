   "source": [
    "from gensim.models import KeyedVectors\n",
    "\n",
    "input_file = \"GoogleNews-vectors-negative300.bin\"\n",
    "output_file = \"GoogleNews-vectors-negative300.txt\"\n",
    "\n",
    "model = KeyedVectors.load_word2vec_format(\n",
    "    input_file,\n",
    "    binary=True\n",
    ")\n",
    "\n",
    "model.save_word2vec_format(\n",
    "    output_file,\n",
    "    binary=False\n",
    ")"
   ]
  }
 ],
